PORT=8787
# 监听地址。默认 127.0.0.1：只有本机能连，没有令牌，也没有共享。
# 改成 0.0.0.0 就是局域网共享 —— 此时所有接口自动要求访问链接（令牌层见 access.ts），
# 启动时终端会打印「控制席 / 检查席」两条带 #t= 的链接，把对应的那条发给对方即可。
# 检查席只能看被共享出来的对话，发指令、应答弹窗、改设置都归控制席。
# 注意仍然没有 HTTPS：同一局域网里抓包能看到令牌，只在可信网络里开。
HOST=127.0.0.1
# 强制令牌层的开关。留空 = 按 HOST 判断（回环关、非回环开）；on = 连回环上也要求令牌
# （测试用）。没有 off —— 公开绑定又不鉴权，等于把这台机器的任意命令执行权限交出去。
SHARE_AUTH=
PERMISSION_TOOLS=bash

# 模型能力。
# 溢出判断用「即将发送的实际大小」= max(消息估算, 上次实测 - 本次裁剪释放量)。
# 单用上次的实测值会滞后一步，那正是上下文涨到 100% 而压缩不触发的成因。
CONTEXT_WINDOW=128000
# 留空时候算 = CONTEXT_WINDOW - COMPACTION_RESERVED，默认 128000 - 20000 = 108000。
# 若模型单独声明了输入上限（和总窗口不同）才填这里，此时预算 = 此值 - MAX_OUTPUT_TOKENS。
CONTEXT_INPUT_LIMIT=
MAX_OUTPUT_TOKENS=4096
# 预留缓冲。必须覆盖「一步之内新增的工具输出」——单次工具输出上限是 20000 字符（约 5k token），
# 留小了会在你反应过来之前把请求顶出模型上限。留空 = 20000
COMPACTION_RESERVED=

# 压缩（算法对齐 opencode，但这里清理得更早 —— 见 PRUNE_PROTECT）
COMPACTION_AUTO=true
# 从最旧的工具输出开始清理（当前这一轮也清），保留最近这么多 token 的工具输出。留空 = 12000
COMPACTION_PRUNE=true
PRUNE_PROTECT=12000
# 一次清理至少要释放这么多 token 才真的动手，避免为了几个字符反复裁剪。留空 = 6000
PRUNE_MINIMUM=6000
# 保留的最近上下文预算。留空 = clamp(可用 * 0.25, 2000, 15000)
PRESERVE_RECENT_TOKENS=
# 只从最近 N 轮里挑保留的尾巴。留空 = 不限
TAIL_TURNS=
# 摘要走便宜模型时填这里，留空用当前模型
SUMMARIZE_MODEL=

# 笔记（每个对话一份；别的对话看不到）
# 笔记文件本身不限大小，但每次 prompt 只注入这么多 token。
# 超出部分不注入，改为在 prompt 里列出小节名，agent 需要时用 note 工具单独读。
NOTE_INJECT_TOKENS=5000

# 联网（默认关闭）
# fetch 工具让 agent 能抓公开网页的正文。默认关闭，因为 README 的第一条承诺是
# 「只监听 127.0.0.1，不上云、不联网」—— 打开它等于撤掉那条。
# 注意：抓回来的是**别人写的内容**，属于不可信输入（prompt injection 的入口）。
WEB_FETCH=false

# 多模态
# false = 保留附件但请求里换成文字占位符（给不接受 image content part 的模型）
VISION=true
# 单张图片上限
MAX_UPLOAD_BYTES=8388608
# 单条消息最多几张图
MAX_ATTACHMENTS=6

# 长期记忆预算（token）。超了就从 agent 段最旧的开始清理，user 段不动。
MEMORY_MAX_TOKENS=2000
# agent 提取的推断若这么多轮内没被确认（也没被 probe 自动核验），就清掉。
HYPOTHESIS_TTL_TURNS=20

# 日志
LOG_LEVEL=info
LOG_MAX_BYTES=5242880
LOG_KEEP_FILES=3
LOG_BUFFER_SIZE=2000
LOG_HTTP=true
# 默认只记元数据（字节数、耗时、状态），不记内容。
# 打开下面两个会把 prompt / 工具输出原文写进日志，注意其中有你的代码和可能的密钥。
LOG_LLM_PAYLOAD=false
LOG_TOOL_OUTPUT=false

# 启动后自动打开浏览器（gt 会设置它）
OPEN_BROWSER=

# 下面这些可以留空 —— 直接在 Web UI 的「设置」里填即可。
# 只有想用环境变量固定住默认值时才取消注释。UI 里保存的值优先级更高。
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini
# WORKSPACE_DIR=C:\path\to\your\code
# MCP（外部工具生态）。工具定义会进每个请求，所以有总量上限；超出的不再提供给模型。
MCP_MAX_TOOLS=32
# 单个 MCP JSON-RPC 请求的超时（毫秒）。卡死不回的 server 不会拖住整个回合。
MCP_TIMEOUT_MS=30000
